# ---------- LLM providers (all free tiers) ----------
# Default provider used by the app for themes / aspects / Hinglish generation: gemini | groq | ollama
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# Seconds between calls to cloud LLMs (free-tier rate limits). Increase if you see HTTP 429.
LLM_MIN_INTERVAL=4.0
# Providers compared in the zero-shot evaluation (unavailable ones are skipped automatically)
LLM_EVAL_PROVIDERS=groq
# ---------- Data ----------
LANGS=hi,ta,te,bn,mr
SEED=42
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Required for IndicBERT if you have not authenticated with the Hugging Face CLI.
HF_TOKEN=
